Meta.DisplayName=Cart Horse CI Runner
Meta.Description=Ephemeral repository-scoped GitHub Actions self-hosted runner supervised by AMP
Meta.OS=Linux
Meta.Arch=x86_64
Meta.Author=Cart Horse Studios
Meta.URL=https://github.com/carthorsestudios/carthorse-ci-runner-amp-template
Meta.DisplayImageSource=
Meta.EndpointURIFormat=
Meta.ConfigManifest=carthorseciconfig.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=carthorseci.kvp
Meta.MinAMPVersion=2.7.2.8
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=CI jobs execute repository code. Container isolation keeps the runner separate from production game instances and the host filesystem.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["python3","git","curl","ca-certificates","tar","gzip","libkrb5-3","zlib1g","libssl-dev","libicu-dev","liblttng-ust-dev","libatomic1"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ResourceUsageInfo=One job at a time. Recommended starting allocation: 4 CPU cores and 8 GB RAM.
Meta.AppConfigId=e0fc20ae-b177-471c-b988-87683e692992
App.DisplayName=Cart Horse CI Runner
App.RootDir=./
App.BaseDirectory=./
App.ExecutableWin=
App.ExecutableLinux=/bin/bash
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-lc eval\${IFS}\$(printf\${IFS}%s\${IFS}|base64\${IFS}-d)
App.UseLinuxIOREDIR=False
App.AppSettings={"TargetRepository":"carthorsestudios/poobiverse-classic","RunnerLabels":"carthorse-ci,oldgrid","RunnerNamePrefix":"carthorse-oldgrid","RunnerVersion":"latest","RestartDelaySeconds":"3"}
App.EnvironmentVariables={"CARTHORSE_GITHUB_REPOSITORY":"{{TargetRepository}}","CARTHORSE_GITHUB_TOKEN":"{{GitHubToken}}","CARTHORSE_RUNNER_LABELS":"{{RunnerLabels}}","CARTHORSE_RUNNER_NAME_PREFIX":"{{RunnerNamePrefix}}","CARTHORSE_RUNNER_VERSION":"{{RunnerVersion}}","CARTHORSE_RESTART_DELAY_SECONDS":"{{RestartDelaySeconds}}"}
App.CommandLineParameterFormat=--{0}={1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=SIGTERM
App.ExitTimeout=45
App.ExitString=
App.ExitFile=
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[carthorseciports.json]
App.AdminPortRef=
App.PrimaryApplicationPortRef=
App.UniversalSleepApplicationUDPPortRef=
App.UniversalSleepSteamQueryPortRef=
App.MaxUsers=1
App.UseRandomAdminPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat={0}
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.MonitorChildProcess=False
App.MonitorChildProcessWaitMs=100
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^\[CartHorseCI\] Ready repository=.+ runner=.+ version=.+ labels=.+$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
App.UpdateSources=@IncludeJson[carthorseciupdates.json]
